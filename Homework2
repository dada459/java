import java.util.Scanner;

class Student{
    String name, major;
    int stuID;
    long phone;

    public void setName(String Name){
        this.name=Name;
    }
    public String getName(){
        return name;
    }

    public void setMajor(String Major){
        this.major=Major;
    }
    public String getMajor(){
        return major;
    }

    public void setStuID(int StuID){
        this.stuID=StuID;
    }
    public int getStuID(){
        return stuID;
    }

    public void setPhone(long Phone){
        this.phone=Phone;
    }
    public long getPhone(){
        return phone;
    }

    public String getFormattedPhone() {
        String digits = "0" + Long.toString(phone); // 010으로 시작하는 11자리 번호라는 전제
        return digits.substring(0, 3) + "-"
                + digits.substring(3, 7) + "-"
                + digits.substring(7);
    }
}

class Homework2{
    public static void main(String[] args){
        Scanner sc = new Scanner(System.in);
        Student[] students = new Student[3];//학생 객체를 담을 자리 3개

        for(int i=0;i<3;i++){
            students[i] = new Student();//i번째 학생 객체 만들기
            System.out.printf("학생의 학번, 이름, 전공, 전화번호를 입력하세요: ");

            students[i].setStuID(sc.nextInt());
            students[i].setName(sc.next());
            students[i].setMajor(sc.next());
            students[i].setPhone(sc.nextLong());
        }

        System.out.println("입력된 학생들의 정보는 다음과 같습니다.");

        for(int i=0;i<3;i++){
            System.out.println((i+1)+"번째 학생 "
                    +students[i].getStuID()+" "
                    +students[i].getName()+" "
                    +students[i].getMajor()+" "
                    +students[i].getFormattedPhone());
        }
    }
}
