import java.util.Scanner;

public class Homework3 {
    public static void main(String[] args){
        Scanner sc = new Scanner(System.in);
        int num;
        int i;

        System.out.println("제발 정수를 입력하세요");
        System.out.print("몇 개의 수를 입력할 예정인가요?" );
        num = sc.nextInt();

        System.out.printf("%d 개의 수를 입력하세요", num);
        int[] Arr = new int[num];//num만큼의 원소를 가지는 배열 만들기
        for(i=0;i<num;i++) {//값 넣기
            int trash = sc.nextInt();
            Arr[i]=trash;
        }
        int min=Arr[0],max=Arr[0];
        for(i=0;i<num;i++){//배열에서 최댓값 구하기
            if(max<Arr[i])
                max=Arr[i];
        }

        for(i=0;i<num;i++){//배열에서 최솟값 구하기
            if(min>Arr[i])
                min=Arr[i];
        }
        System.out.println("최댓값"+max);
        System.out.println("최솟값"+min);
    }
}
